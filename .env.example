# 复制为 .env 后按需修改
# 访问密码（必改）
ACCESS_PASSWORD=changeme
# 会话签名密钥（必改，随便一串长随机字符）
SECRET_KEY=please-change-me-to-a-long-random-string
# 打字机速度：1.0 为默认；越大越快
TYPING_SPEED=1.0
# 监听地址：默认仅本机；公网部署改成 0.0.0.0（并务必设置强密码 / 反代鉴权）
BIND_HOST=127.0.0.1
# 对外端口
PORT=8000
# 若通过 HTTPS 反向代理访问，设为 true（Cookie 仅走安全连接）
COOKIE_SECURE=false