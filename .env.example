# 复制为 .env 后按需修改
# 会话签名密钥（必填、必改）：用 openssl rand -hex 32 生成
# 注意：存在账号后若仍是默认弱值，服务会拒绝启动（否则会话 Cookie 可被伪造）
SECRET_KEY=please-change-me-to-a-long-random-string
# 打字机速度：1.0 为默认；越大越快
TYPING_SPEED=1.0
# 监听地址：默认仅本机；公网部署改成 0.0.0.0（并务必走 HTTPS）
BIND_HOST=127.0.0.1
# 对外端口
PORT=8000
# 若通过 HTTPS 反向代理访问，设为 true（Cookie 仅走安全连接）
COOKIE_SECURE=false

# 说明：账号不再由环境变量配置。首次启动后打开网页会进入「创建管理员」引导，
# 需要的引导口令会打印在容器日志里（docker compose logs）。